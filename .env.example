DATABASE_URL=postgres://postgres:toor@localhost:5432/arocall
JWT_SECRET=dev-secret-change-me
PORT=4000
STORAGE_DIR=./storage/audio
# Meta Model API (https://dev.meta.ai) — ONE key for all Muse models.
MODEL_API_KEY=
MUSE_BASE_URL=https://api.meta.ai
# LLM for criteria generation, call scoring/reports, memos, coaching replies
MUSE_LLM_MODEL=muse-spark-1.3-contributor
# STT for call transcription (turn-level timestamps + diarization)
MUSE_STT_MODEL=muse-voice-transcribe-1.0
# true = deterministic mock paths (labeled in UI). Live calls need MODEL_API_KEY + false.
MUSE_MOCK=true
# Token budget for guidelines in scoring prompts (full vs mandatory-only mode)
GUIDELINE_TOKEN_BUDGET=60000
# NOTE: Muse has no speech-synthesis model (Voice Transcribe is STT-only),
# so Meet coach voice output uses OpenAI TTS. Browser fallback uses speechSynthesis.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS=Warm, calm, supportive coach. Natural pace.
# AI coaching transport: meet (Google Meet + coach-bot) or inapp (browser fallback)
COACH_TRANSPORT=meet
COACH_MAX_SESSION_MIN=25
COACH_JOIN_TIMEOUT_MIN=10
COACH_BOT_SECRET=dev-bot-secret-change-me
COACH_BOT_PROFILE_DIR=/tmp/opencode/coach-bot-profile
COACH_BOT_HEADLESS=true
GOOGLE_REDIRECT_URI=http://localhost:4000/api/settings/integrations/google/callback-public
# Public URL of the web app — OAuth callbacks redirect back here (Settings > Integrations).
FRONTEND_URL=http://localhost:5173
# Invite email via Gmail (app password). Without these, invites are logged,
# not sent — the room page still shows copy/email-link options.
# Create one at Google Account → Security → 2-Step Verification → App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_NOTIFICATION_FROM=Arocall <no-reply@arocall.ai>
# Master key for session-key encryption (AES-256-GCM). Any 32-byte hex/base64
# string works; other strings are hashed to 32 bytes. Rotate via KMS later.
KEY_MASTER=dev-master-key-change-me-in-production
# Google login: create OAuth 2.0 credentials (Web app) in Google Cloud Console.
# Used by BOTH flows below (same Client ID): GIS login button (JS origins only)
# and Meet server-side OAuth (redirect URIs). See "Google setup" section.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_API_URL=http://localhost:4000
