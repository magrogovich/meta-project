# Coach Bot env template — copy to .env and fill in. Never commit .env.
# COACH_BOT_SECRET must equal the API's root .env value.
ARO_API=http://localhost:4000
COACH_BOT_SECRET=change-me-to-match-api-env
COACH_BOT_PROFILE_DIR=/tmp/opencode/coach-bot-profile
# guest = join signed-out as "Arocall AI Coach", no login needed (needs OPEN spaces).
# account = use the persistent profile (npm run login) for Workspaces forcing sign-in.
COACH_BOT_JOIN_MODE=guest
# Browser channel for account-mode login/joins: empty = bundled Chromium.
# If Google says "This browser or app may not be secure", install real Chrome
# and set COACH_BOT_CHANNEL=chrome. (Guest mode never logs in — unaffected.)
COACH_BOT_HEADLESS=true
COACH_BOT_DEBUG_DIR=/tmp/opencode/coach-bot-debug
COACH_MAX_SESSION_MIN=25
# Empty = mock TTS (logs text, plays nothing). Set to speak in meetings.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS=Warm, calm, supportive coach. Natural pace.
